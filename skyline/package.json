{
  "name": "skyline-student-organization-system",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/database.mjs push",
    "db:seed": "node -e \"console.error('Demo seeding is disabled. Use administrative bootstrap for initial setup.'); process.exit(1)\"",
    "db:generate": "node scripts/database.mjs generate",
    "db:validate": "node scripts/database.mjs validate",
    "db:export": "node scripts/data-transfer.mjs export",
    "db:import": "node scripts/data-transfer.mjs import",
    "account:bootstrap": "tsx scripts/create-staff.ts",
    "events:jobs": "tsx scripts/event-jobs.ts",
    "events:watch": "tsx scripts/event-jobs.ts --watch",
    "postinstall": "node scripts/database.mjs generate",
    "verify": "node scripts/verify.mjs",
    "verify:payments": "tsx scripts/verify-payments.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/*.{ts,mjs}\" \"prisma/schema.prisma\" \"*.{json,mjs}\" --ignore-unknown",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/*.{ts,mjs}\" \"*.{json,mjs}\" --ignore-unknown",
    "verify:otp": "tsx scripts/verify-otp.ts --temporary-fixtures",
    "verify:events": "tsx scripts/verify-events.ts --temporary-fixtures",
    "verify:finance": "tsx scripts/verify-finance.ts --temporary-fixtures",
    "email:check": "tsx scripts/check-email.ts",
    "verify:email": "tsx scripts/verify-email-delivery.ts --temporary-fixtures"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@prisma/fetch-engine": "6.19.3",
    "@zxing/browser": "^0.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^14.2.30",
    "nodemailer": "^10.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
