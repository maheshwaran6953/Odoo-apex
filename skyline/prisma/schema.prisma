generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
}
enum TicketType {
  MEMBER
  NON_MEMBER
}
enum TicketStatus {
  RESERVED
  PAID
  CHECKED_IN
  CANCELLED
}
enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}
enum TaskStatus {
  TODO
  DOING
  DONE
}
enum TransactionType {
  INCOME
  EXPENSE
}
enum TransactionCategory {
  DUES
  TICKET
  MERCHANDISE
  FUNDRAISER
  REIMBURSEMENT
  OTHER
}

model Member {
  id String @id @default(cuid())
  name String
  email String @unique
  phone String?
  membership Membership?
  tickets Ticket[]
  orders MerchandiseOrder[]
  tasks Task[]
  transactions Transaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User?
}
model Membership {
  id String @id @default(cuid())
  memberId String @unique
  status MembershipStatus @default(PENDING)
  duesCents Int @default(0)
  expiresAt DateTime
  member Member @relation(fields: [memberId], references: [id])
}
model Event {
  id String @id @default(cuid())
  name String
  description String
  startsAt DateTime
  location String
  capacity Int
  memberPriceCents Int
  nonMemberPriceCents Int
  tickets Ticket[]
  registrationClosesAt DateTime?
  organizerEmail String?
  schedule String @default("")
  cancelledAt DateTime?
  version Int @default(0)
  currency String @default("USD")
  paymentMode String @default("PRACTICE")
  payments Payment[]
  waitlist WaitlistEntry[]
}
model Ticket {
  id String @id @default(cuid())
  code String @unique
  eventId String
  memberId String?
  type TicketType
  status TicketStatus @default(PAID)
  priceCents Int
  event Event @relation(fields: [eventId], references: [id])
  member Member? @relation(fields: [memberId], references: [id])
  checkedInAt DateTime?
  createdAt DateTime @default(now())
  userId String?
  user User? @relation(fields: [userId], references: [id])
  attendeeName String @default("")
  attendeeEmail String @default("")
  attendeePhone String?
  qrToken String? @unique
  cancelledAt DateTime?
  reminderAt DateTime?
  ledgerId String? @unique
  currency String @default("USD")
  paymentMode String @default("PRACTICE")
  payments Payment[]
  @@unique([eventId, userId])
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role String @default("MEMBER")
  memberId String? @unique
  member Member? @relation(fields: [memberId], references: [id])
  emailVerifiedAt DateTime?
  disabledAt DateTime?
  emailReminders Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
  tickets Ticket[]
  waitlist WaitlistEntry[]
  notifications Notification[]
  tokens AccountToken[]
  payments Payment[]
}

model Payment {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  amountCents Int
  currency String @default("INR")
  ticketType TicketType
  attendeePhone String?
  status String @default("INIT")
  providerOrderId String? @unique
  providerPaymentId String? @unique
  providerRefundId String? @unique
  ticketId String?
  ticket Ticket? @relation(fields: [ticketId], references: [id])
  ledgerId String? @unique
  expiresAt DateTime
  capturedAt DateTime?
  refundedAt DateTime?
  lastCheckedAt DateTime?
  issue String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([eventId, status, expiresAt])
  @@index([userId, createdAt])
}

model PaymentWebhook {
  id String @id
  bodyHash String
  eventType String
  completed Boolean @default(false)
  processedAt DateTime @default(now())
}

model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}

model AccountToken {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  expiresAt DateTime
}

model LoginAttempt {
  id String @id
  failures Int @default(0)
  updatedAt DateTime @updatedAt
}

model WaitlistEntry {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  status String @default("WAITING")
  createdAt DateTime @default(now())
  offeredAt DateTime?
  offerExpiresAt DateTime?
  @@unique([eventId, userId])
  @@index([eventId, status, createdAt])
}

model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  key String @unique
  title String
  body String
  href String
  readAt DateTime?
  createdAt DateTime @default(now())
}

model EmailMessage {
  id String @id @default(cuid())
  key String @unique
  to String
  subject String
  body String
  status String @default("QUEUED")
  attempts Int @default(0)
  lastError String?
  sentAt DateTime?
  claimedAt DateTime?
  providerId String?
  createdAt DateTime @default(now())
}
model InventoryItem {
  id String @id @default(cuid())
  name String
  category String
  size String?
  priceCents Int
  stock Int
  orderLines MerchandiseOrderLine[]
}
model MerchandiseOrder {
  id String @id @default(cuid())
  memberId String?
  status OrderStatus @default(PENDING)
  totalCents Int
  member Member? @relation(fields: [memberId], references: [id])
  lines MerchandiseOrderLine[]
  createdAt DateTime @default(now())
}
model MerchandiseOrderLine {
  id String @id @default(cuid())
  orderId String
  itemId String
  quantity Int
  unitPriceCents Int
  order MerchandiseOrder @relation(fields: [orderId], references: [id])
  item InventoryItem @relation(fields: [itemId], references: [id])
}
model Task {
  id String @id @default(cuid())
  title String
  description String?
  status TaskStatus @default(TODO)
  dueAt DateTime?
  assigneeId String?
  assignee Member? @relation(fields: [assigneeId], references: [id])
}
model Transaction {
  id String @id @default(cuid())
  type TransactionType
  category TransactionCategory
  description String
  amountCents Int
  memberId String?
  receiptUrl String?
  status String @default("posted")
  currency String @default("USD")
  member Member? @relation(fields: [memberId], references: [id])
  createdAt DateTime @default(now())
}
model Announcement {
  id String @id @default(cuid())
  title String
  body String
  audience String @default("All members")
  publishedAt DateTime @default(now())
}
